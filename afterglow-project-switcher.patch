diff --git a/src/components/ProjectSwitcher.jsx b/src/components/ProjectSwitcher.jsx
new file mode 100644
index 0000000..535d57d
--- /dev/null
+++ b/src/components/ProjectSwitcher.jsx
@@ -0,0 +1,116 @@
+import { useState, useEffect, useRef } from "react";
+import { ChevronDown, ChevronUp, Check, Circle } from "lucide-react";
+
+/**
+ * 전시(프로젝트) 선택 스위처
+ *
+ * props:
+ *  - clients:   CLIENTS 배열
+ *  - clientId:  현재 고객사 id (운영자는 고정, 슈퍼는 선택 가능)
+ *  - projectId: 현재 전시 id
+ *  - mode:      "operator" | "super"
+ *  - onSelect:  (clientId, projectId) => void
+ *  - compact:   모바일 등 좁은 영역용 (선택)
+ */
+export default function ProjectSwitcher({ clients = [], clientId, projectId, mode = "operator", onSelect = () => {}, compact = false }) {
+  const [open, setOpen] = useState(false);
+  const ref = useRef(null);
+
+  useEffect(() => {
+    const onDoc = (e) => { if (ref.current && !ref.current.contains(e.target)) setOpen(false); };
+    document.addEventListener("mousedown", onDoc);
+    return () => document.removeEventListener("mousedown", onDoc);
+  }, []);
+
+  const client = clients.find((c) => c.id === clientId);
+  const project = client?.projects.find((p) => p.id === projectId);
+
+  // 슈퍼: 전체 고객사. 운영자: 본인 고객사만.
+  const visibleClients = mode === "super" ? clients : clients.filter((c) => c.id === clientId);
+
+  const pick = (cid, pid) => { onSelect(cid, pid); setOpen(false); };
+
+  return (
+    <div ref={ref} style={{ position: "relative", display: "inline-block" }}>
+      {/* Trigger */}
+      <button
+        onClick={() => setOpen(!open)}
+        aria-haspopup="listbox"
+        aria-expanded={open}
+        style={{
+          display: "flex", alignItems: "center", gap: 7,
+          background: "white", border: "1px solid rgba(0,0,0,0.12)",
+          borderRadius: 8, padding: compact ? "5px 9px" : "6px 11px",
+          cursor: "pointer", fontFamily: "'DM Sans',sans-serif",
+          marginTop: 3, maxWidth: "100%",
+        }}
+      >
+        <span style={{ fontSize: compact ? 12.5 : 13.5, fontWeight: 600, color: "#0D0D0F", whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>
+          {project ? project.title : "전시 선택"}
+        </span>
+        {client && <span style={{ fontSize: 11.5, color: "#9A9490", whiteSpace: "nowrap" }}>· {client.name}</span>}
+        {open
+          ? <ChevronUp size={14} color="#9A9490" style={{ flexShrink: 0 }} />
+          : <ChevronDown size={14} color="#9A9490" style={{ flexShrink: 0 }} />}
+      </button>
+
+      {/* Panel */}
+      {open && (
+        <div
+          role="listbox"
+          style={{
+            position: "absolute", top: "calc(100% + 6px)", left: 0, zIndex: 60,
+            minWidth: 260, maxWidth: 320, maxHeight: 380, overflow: "auto",
+            background: "white", border: "1px solid rgba(0,0,0,0.1)",
+            borderRadius: 12, boxShadow: "0 12px 36px rgba(0,0,0,0.16)",
+            padding: 6, fontFamily: "'DM Sans',sans-serif",
+          }}
+        >
+          {visibleClients.map((c) => (
+            <div key={c.id} style={{ marginBottom: 4 }}>
+              <div style={{
+                fontSize: 11, color: "#9A9490", fontFamily: "'DM Mono',monospace",
+                padding: "8px 10px 5px", letterSpacing: "0.02em",
+              }}>
+                {c.name} — 전시 {c.projects.length}
+              </div>
+              {c.projects.map((p) => {
+                const selected = c.id === clientId && p.id === projectId;
+                return (
+                  <button
+                    key={p.id}
+                    role="option"
+                    aria-selected={selected}
+                    onClick={() => pick(c.id, p.id)}
+                    style={{
+                      width: "100%", display: "flex", alignItems: "center", justifyContent: "space-between",
+                      gap: 10, padding: "10px 10px", border: "none", cursor: "pointer",
+                      borderRadius: 8, background: selected ? "rgba(201,168,76,0.12)" : "transparent",
+                      fontFamily: "'DM Sans',sans-serif", textAlign: "left",
+                    }}
+                    onMouseEnter={(e) => { if (!selected) e.currentTarget.style.background = "#F7F5F0"; }}
+                    onMouseLeave={(e) => { if (!selected) e.currentTarget.style.background = "transparent"; }}
+                  >
+                    <span style={{ display: "flex", alignItems: "center", gap: 9, minWidth: 0 }}>
+                      {selected
+                        ? <Check size={15} color="#C9A84C" style={{ flexShrink: 0 }} />
+                        : <Circle size={6} fill="#D4CFC5" color="#D4CFC5" style={{ flexShrink: 0, margin: "0 4.5px" }} />}
+                      <span style={{
+                        fontSize: 14, fontWeight: selected ? 600 : 400,
+                        color: selected ? "#8B6914" : "#2A2A2A",
+                        whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis",
+                      }}>{p.title}</span>
+                    </span>
+                    <span style={{ fontSize: 11.5, color: p.statusColor || "#9A9490", flexShrink: 0, fontFamily: "'DM Mono',monospace" }}>
+                      {p.status}
+                    </span>
+                  </button>
+                );
+              })}
+            </div>
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/src/data/projects.js b/src/data/projects.js
new file mode 100644
index 0000000..5519595
--- /dev/null
+++ b/src/data/projects.js
@@ -0,0 +1,44 @@
+// 멀티테넌트 목업 데이터
+// 계층: CLIENT(고객사) 1 ──< PROJECT(전시) N ──< 세션/관람 데이터
+// 실제 연동 시 이 파일을 API 응답으로 대체하면 됩니다.
+// 운영자(기획자)는 본인 client_id 하위 전시 전부를 열람할 수 있고,
+// 슈퍼 어드민(에프터글로우)은 client 경계 없이 전체를 봅니다.
+
+export const CLIENTS = [
+  {
+    id: "cl_peoply",
+    name: "피플리",
+    projects: [
+      { id: "pj_abyss", title: "빛의 심연", status: "운영 중",  statusColor: "#4CAF7C", date: "2026.05.16" },
+      { id: "pj_moon",  title: "달빛 정원", status: "팝업 준비", statusColor: "#C9A84C", date: "2026.06.01" },
+      { id: "pj_time",  title: "시간의 결", status: "종료",     statusColor: "#9A9490", date: "2026.03.10" },
+    ],
+  },
+  {
+    id: "cl_seraphim",
+    name: "세라핌컴퍼니",
+    projects: [
+      { id: "pj_bloom", title: "무한의 정원", status: "운영 중", statusColor: "#4CAF7C", date: "2026.05.20" },
+    ],
+  },
+];
+
+// 현재 로그인한 운영자가 속한 고객사 (실제로는 인증 토큰의 client_id)
+export const CURRENT_OPERATOR_CLIENT_ID = "cl_peoply";
+
+export function getClient(clientId) {
+  return CLIENTS.find((c) => c.id === clientId) || null;
+}
+
+export function getProject(clientId, projectId) {
+  const client = getClient(clientId);
+  if (!client) return null;
+  return client.projects.find((p) => p.id === projectId) || null;
+}
+
+// 운영자의 기본 진입 전시 (해당 고객사의 첫 번째 전시)
+export function defaultSelection(clientId = CURRENT_OPERATOR_CLIENT_ID) {
+  const client = getClient(clientId);
+  const first = client?.projects[0];
+  return { clientId, projectId: first?.id || null };
+}
